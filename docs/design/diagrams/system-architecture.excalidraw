    {
      "type": "text",
      "id": "evidence_t",
      "x": 580,
      "y": 795,
      "width": 600,
      "height": 120,
      "text": "// Submit flow · ADR-004 / NFR-06\n1. validate: non-empty, <= 20 MiB, allowed type\n2. PUT R2 submissions/<uuid>     (file first)\n3. INSERT submissions row        (new row per attempt)\n4. on failure: DELETE R2 object  (compensate)\n=> success only after file AND record persist",
      "originalText": "// Submit flow · ADR-004 / NFR-06\n1. validate: non-empty, <= 20 MiB, allowed type\n2. PUT R2 submissions/<uuid>     (file first)\n3. INSERT submissions row        (new row per attempt)\n4. on failure: DELETE R2 object  (compensate)\n=> success only after file AND record persist",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#22c55e",
